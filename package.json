{
  "name": "react-virtual-tree-view",
  "version": "0.0.0",
  "description": "Headless TreeView and DraggableTreeView for React, built for large trees and dnd-kit drag & drop.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:unit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "react",
    "tree",
    "tree-view",
    "drag-and-drop",
    "dnd-kit",
    "virtualization",
    "headless"
  ],
  "license": "MIT",
  "author": "Daniele Ingusci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Utumno1984/react-virtual-tree-view.git"
  },
  "homepage": "https://github.com/Utumno1984/react-virtual-tree-view#readme",
  "bugs": {
    "url": "https://github.com/Utumno1984/react-virtual-tree-view/issues"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "http-server": "^14.1.1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
